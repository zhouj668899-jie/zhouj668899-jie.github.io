---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, TRACKS, PROJECTS, JOIN } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base>
  <!-- 首屏 -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="eyebrow">你好，我是 Jay 👋</p>
        <h1>做医疗器械的工程师，<br />也在用 AI 重做自己的工作方式。</h1>
        <p class="hero-lead">
          平时和导管、鞘管、弹簧图纸打交道；剩下的时间，把这些经验做成 AI 工具，再教给需要的人。
        </p>
        <div class="hero-tags">
          <a href="#track-med" class="pill">🩺 医疗器械工程</a>
          <a href="#track-ai" class="pill">🤖 AI 工作流</a>
        </div>
        <div class="hero-actions">
          <a href="#join" class="btn primary">加入会员 / 找我合作</a>
          <a href="#projects" class="btn">看看作品</a>
        </div>
      </div>
      <div class="hero-art">
        <img src="/img/jay-wave.png" alt="Jay 的卡通形象，戴眼镜、穿黑色卫衣，正在挥手" width="640" height="640" />
      </div>
    </div>
  </section>

  <!-- 两条主线 -->
  <section class="section" id="work">
    <div class="wrap">
      <p class="eyebrow">在做什么</p>
      <h2 class="section-title">两条线，一件事：把专业活干得又快又准</h2>
      <div class="tracks">
        {TRACKS.map((t) => (
          <article class="card track" id={`track-${t.key}`}>
            <div class="track-head">
              <img src={t.img} alt="" width="96" height="96" loading="lazy" />
              <div>
                <span class="track-label">{t.label}</span>
                <h3>{t.title}</h3>
              </div>
            </div>
            <p class="track-intro">{t.intro}</p>
            <ul class="track-items">
              {t.items.map((i) => (
                <li>
                  <strong>{i.name}</strong>
                  <span>{i.text}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 作品 -->
  <section class="section alt" id="projects">
    <div class="wrap">
      <p class="eyebrow">作品</p>
      <h2 class="section-title">做过的一些公开项目</h2>
      <p class="section-lead">都是能直接打开的网页，点卡片就能看。</p>
      <div class="grid">
        {PROJECTS.map((p) => (
          <a class="card proj" href={p.url} target="_blank" rel="noopener">
            <span class="tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="go">打开 ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 文章 -->
  {posts.length > 0 && (
    <section class="section" id="posts">
      <div class="wrap">
        <div class="row-head">
          <div>
            <p class="eyebrow">文章</p>
            <h2 class="section-title">最近写的</h2>
          </div>
          <a href="/blog/" class="more">全部文章 →</a>
        </div>
        <div class="posts">
          {posts.map((p) => (
            <a class="card post" href={`/blog/${p.id}/`}>
              <time>{fmt(p.data.date)}</time>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 加入 / 合作 -->
  <section class="section alt" id="join">
    <div class="wrap">
      <p class="eyebrow">加入 / 合作</p>
      <h2 class="section-title">想一起用 AI 把活干好？</h2>
      <div class="join">
        <article class="card join-card member">
          <div class="join-top">
            <h3>{JOIN.member.title}</h3>
            <span class="price">{JOIN.member.price}</span>
          </div>
          <ul>{JOIN.member.points.map((x) => <li>{x}</li>)}</ul>
          <p class="note">{JOIN.member.note}</p>
          {SITE.douyinUrl ? (
            <a class="btn primary" href={SITE.douyinUrl} target="_blank" rel="noopener">去抖音开通会员</a>
          ) : (
            <p class="hint">在抖音打开我的主页 → 专属会员{SITE.douyinId && `（抖音号：${SITE.douyinId}）`}</p>
          )}
        </article>
        <article class="card join-card">
          <div class="join-top">
            <h3>{JOIN.business.title}</h3>
          </div>
          <ul>{JOIN.business.points.map((x) => <li>{x}</li>)}</ul>
          <p class="note">{JOIN.business.note}</p>
          {SITE.wechatQr ? (
            <img class="qr" src={SITE.wechatQr} alt="企业合作微信二维码" width="160" height="160" />
          ) : (
            <div class="qr placeholder">微信二维码<br />即将上线</div>
          )}
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 56px 0 40px; overflow: hidden; }
  .hero-inner { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 860px) {
    .hero { padding: 88px 0 72px; }
    .hero-inner { grid-template-columns: 1.25fr 1fr; gap: 48px; }
  }
  .hero h1 { font-size: clamp(30px, 5.2vw, 48px); font-weight: 800; }
  .hero-lead { font-size: clamp(16px, 2vw, 19px); color: var(--ink-2); margin: 20px 0 0; max-width: 34em; }
  .hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .pill {
    font-size: 14px; padding: 6px 14px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--line); color: var(--ink);
  }
  .pill:hover { border-color: var(--accent); text-decoration: none; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 12px 22px; border-radius: 12px; font-weight: 600; font-size: 15px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
  }
  .btn:hover { text-decoration: none; border-color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { background: var(--accent-ink); }
  .hero-art { position: relative; justify-self: center; width: min(360px, 78vw); }
  .hero-art::before {
    content: ''; position: absolute; inset: 6%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
    transform: scale(1.35); z-index: -1;
  }
  .hero-art img { border-radius: 32px; box-shadow: var(--shadow); border: 1px solid var(--line); }

  .section.alt { background: color-mix(in srgb, var(--surface) 55%, var(--bg)); border-block: 1px solid var(--line); }

  .tracks { display: grid; gap: 20px; margin-top: 32px; }
  @media (min-width: 860px) { .tracks { grid-template-columns: 1fr 1fr; } }
  .track { padding: 28px; }
  .track-head { display: flex; align-items: center; gap: 16px; }
  .track-head img { width: 72px; height: 72px; border-radius: 18px; border: 1px solid var(--line); }
  .track-label { font-size: 13px; color: var(--muted); }
  .track h3 { font-size: 22px; }
  .track-intro { color: var(--ink-2); margin: 16px 0 8px; }
  .track-items { list-style: none; padding: 0; margin: 0; }
  .track-items li { padding: 14px 0; border-top: 1px dashed var(--line); display: grid; gap: 2px; }
  .track-items strong { font-size: 16px; }
  .track-items span { color: var(--ink-2); font-size: 15px; }

  .grid { display: grid; gap: 16px; margin-top: 28px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .proj { padding: 22px; color: var(--ink); display: flex; flex-direction: column; gap: 8px; transition: transform .15s, border-color .15s; }
  .proj:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-2px); }
  .proj h3 { font-size: 18px; }
  .proj p { margin: 0; color: var(--ink-2); font-size: 15px; flex: 1; }
  .tag {
    align-self: flex-start; font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 999px;
    background: var(--accent-soft); color: var(--accent-ink);
  }
  .go { font-size: 14px; color: var(--accent-ink); font-weight: 600; }

  .row-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .more { font-weight: 600; white-space: nowrap; }
  .posts { display: grid; gap: 16px; margin-top: 28px; }
  @media (min-width: 860px) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .post { padding: 22px; color: var(--ink); }
  .post:hover { text-decoration: none; border-color: var(--accent); }
  .post time { font-size: 13px; color: var(--muted); }
  .post h3 { font-size: 18px; margin-top: 6px; }
  .post p { margin: 8px 0 0; color: var(--ink-2); font-size: 15px; }

  .join { display: grid; gap: 20px; margin-top: 32px; }
  @media (min-width: 860px) { .join { grid-template-columns: 1fr 1fr; } }
  .join-card { padding: 28px; display: flex; flex-direction: column; }
  .join-card.member { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .join-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .join-card h3 { font-size: 22px; }
  .price { font-size: 20px; font-weight: 750; color: var(--warm); }
  .join-card ul { padding-left: 1.2em; margin: 16px 0 8px; color: var(--ink-2); }
  .join-card li { margin: 6px 0; }
  .note { color: var(--muted); font-size: 14px; margin: 0 0 20px; }
  .hint { margin: auto 0 0; padding: 12px 16px; border-radius: 12px; background: var(--accent-soft); color: var(--accent-ink); font-weight: 600; font-size: 15px; }
  .join-card .btn { margin-top: auto; align-self: flex-start; }
  .qr { width: 160px; height: 160px; border-radius: 12px; margin-top: auto; }
  .qr.placeholder {
    display: grid; place-items: center; text-align: center; font-size: 14px; color: var(--muted);
    border: 2px dashed var(--line); line-height: 1.6;
  }
</style>
